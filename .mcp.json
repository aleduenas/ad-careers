{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ],
      "env": {}
    },
    "career_discord": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src/helpers/discord-message.mjs",
        "--mcp"
      ],
      "env": {}
    }
  }
}