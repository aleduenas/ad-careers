{
  "name": "career-ops",
  "version": "1.8.0",
  "description": "Local dashboard-first job-search workflows with PostgreSQL and isolated subscription CLI workers",
  "scripts": {
    "test": "node src/test-all.mjs",
    "web:types": "node src/server/generate-types.mjs",
    "web:typecheck": "npm run web:types && tsc --project web/tsconfig.json --noEmit",
    "web:build": "npm run web:typecheck && vite build --config web/vite.config.mjs",
    "web:dev": "vite --config web/vite.config.mjs",
    "web:start": "node src/server/start.mjs",
    "web:start:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1",
    "web:up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1 -Up",
    "web:down": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1 -Stop",
    "web:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1 -Restart",
    "web:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1 -Status",
    "web:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1 -Install",
    "web:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/helpers/Start-Dashboard.ps1 -Uninstall",
    "tasks:legacy": "node src/helpers/legacy-tasks.mjs",
    "verify": "node src/helpers/verify-pipeline.mjs",
    "pdf": "node src/cvgen/generate-pdf.mjs",
    "scan": "node src/scan/scan.mjs",
    "verify:portals": "node src/helpers/verify-portals.mjs",
    "inspect": "node src/helpers/inspect-pipeline.mjs",
    "draft:cv": "node src/cvgen/draft-cv.mjs",
    "db:up": "node src/helpers/db-infra.mjs up",
    "db:down": "node src/helpers/db-infra.mjs down",
    "db:migrate": "node src/helpers/db-migrate.mjs",
    "db:audit": "node src/helpers/import-legacy.mjs",
    "db:backup": "node src/helpers/db-infra.mjs backup",
    "db:schema": "node src/helpers/db-schema.mjs",
    "test:database": "node src/helpers/test-database.mjs",
    "db:test": "node src/helpers/db-test.mjs",
    "db:cutover": "node src/helpers/db-cutover.mjs",
    "format": "prettier --write \"src/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.mjs\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "fastify": "5.12.8",
    "js-yaml": "^4.1.1",
    "pg": "^8.23.0",
    "playwright": "^1.58.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "^3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
